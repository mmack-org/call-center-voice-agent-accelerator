{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "appExists": {
      "value": "${SERVICE_APP_RESOURCE_EXISTS=false}"
    },
    "modelName": {
      "value": "${AZURE_VOICE_LIVE_MODEL_NAME=gpt-realtime-2.1}"
    },
    "modelVersion": {
      "value": "${AZURE_VOICE_LIVE_MODEL_VERSION=2026-07-07}"
    },
    "modelDeploymentName": {
      "value": "${AZURE_VOICE_LIVE_DEPLOYMENT_NAME=gpt-realtime}"
    },
    "modelSkuName": {
      "value": "${AZURE_VOICE_LIVE_MODEL_SKU=GlobalStandard}"
    },
    "modelCapacity": {
      "value": "${AZURE_VOICE_LIVE_MODEL_CAPACITY=1}"
    },
    "telephonyProvider": {
      "value": "${TELEPHONY_PROVIDER=acs}"
    },
    "twilioAuthToken": {
      "value": "${TWILIO_AUTH_TOKEN}"
    },
    "infobipApiKey": {
      "value": "${INFOBIP_API_KEY}"
    },
    "infobipApiBaseUrl": {
      "value": "${INFOBIP_API_BASE_URL}"
    },
    "genesysApiKey": {
      "value": "${GENESYS_API_KEY}"
    },
    "sinchApplicationKey": {
      "value": "${SINCH_APPLICATION_KEY}"
    },
    "sinchApplicationSecret": {
      "value": "${SINCH_APPLICATION_SECRET}"
    },
    "bandwidthClientId": {
      "value": "${BANDWIDTH_CLIENT_ID}"
    },
    "bandwidthClientSecret": {
      "value": "${BANDWIDTH_CLIENT_SECRET}"
    },
    "bandwidthAccountId": {
      "value": "${BANDWIDTH_ACCOUNT_ID}"
    },
    "bandwidthApplicationId": {
      "value": "${BANDWIDTH_APPLICATION_ID}"
    },
    "debugMode": {
      "value": "${DEBUG_MODE=false}"
    },
    "enableFoundryIq": {
      "value": "${ENABLE_FOUNDRY_IQ=false}"
    },
    "searchServiceName": {
      "value": "${AZURE_AI_SEARCH_SERVICE_NAME=}"
    },
    "searchIndexName": {
      "value": "${AZURE_AI_SEARCH_INDEX_NAME=call-center-content}"
    },
    "foundryIqKnowledgeBaseName": {
      "value": "${AZURE_FOUNDRY_IQ_KNOWLEDGE_BASE_NAME=call-center-knowledge}"
    },
    "foundryAgentName": {
      "value": "${AZURE_AI_FOUNDRY_AGENT_ID=call-center-knowledge-agent}"
    },
    "agentModelName": {
      "value": "${AZURE_AI_AGENT_MODEL_NAME=gpt-4.1-mini}"
    },
    "agentModelVersion": {
      "value": "${AZURE_AI_AGENT_MODEL_VERSION=2025-04-14}"
    },
    "agentModelDeploymentName": {
      "value": "${AZURE_AI_AGENT_MODEL_DEPLOYMENT=gpt-4.1-mini}"
    },
    "agentModelSkuName": {
      "value": "${AZURE_AI_AGENT_MODEL_SKU=GlobalStandard}"
    },
    "agentModelCapacity": {
      "value": "${AZURE_AI_AGENT_MODEL_CAPACITY=10}"
    }
  }
}
